# Copy to .env.local and fill in your own values. Never commit real secrets.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=teamder

# --- Google OAuth ---
GOOGLE_CLIENT_ID_AUTH=your_google_client_id
GOOGLE_CLIENT_SECRET_AUTH=your_google_client_secret
GOOGLE_RedirectCallBackURL_AUTH=http://localhost:3000/api/auth/callback

# --- AI service (teamder_service) ---
TeamderNginxServiceURI=http://localhost
lightGBM_X_API_KEY=your_api_key_from_nginx_api_keys_map

# --- App ---
NEXT_PUBLIC_VERSION=0.1.0
